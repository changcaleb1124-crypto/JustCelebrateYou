// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  recipient   String
  description String?
  createdAt   DateTime @default(now())
  userId          String?
  user            User?    @relation("CreatedEvents", fields: [userId], references: [id], onDelete: Cascade)

  recipientUserId String?
  recipientUser   User?    @relation("ReceivedEvents", fields: [recipientUserId], references: [id], onDelete: Cascade)
  claimToken      String?  @unique
  recipientEmail  String?
  occasion        String?
  coverUrl        String?

  messages VideoMessage[]
}

model User {
  id             String  @id @default(uuid())
  email          String  @unique
  password       String
  name           String?
  tokenVersion   Int     @default(0)
  events         Event[] @relation("CreatedEvents")
  receivedEvents Event[] @relation("ReceivedEvents")
}

model VideoMessage {
  id         String   @id @default(uuid())
  eventId    String
  videoUrl   String
  senderName String
  createdAt       DateTime @default(now())
  fileName        String?
  fileSize        Int?
  mimeType        String?
  storageProvider String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model AuthRateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model MediaCleanupQueue {
  id          String    @id @default(uuid())
  url         String
  eventId     String
  mediaType   String    // "video" | "cover"
  status      String    @default("PENDING") // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED"
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  nextRetryAt DateTime  @default(now())
  lastError   String?
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([eventId])
}

model UploadAuthorization {
  id          String    @id @default(uuid())
  eventId     String
  uploadToken String    @unique
  scopedPath  String    @unique
  status      String    @default("PENDING") // "PENDING" | "CONSUMED" | "EXPIRED"
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([status, expiresAt])
}
